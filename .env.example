# JD Peptides — environment variables
# Copy to .env.local (or set in Vercel/Railway dashboard).
# DO NOT commit .env files with real secrets.

# ---------- Core ----------
SECRET_KEY=                 # random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
DATABASE_URL=               # postgres://...   leave empty for local SQLite
DATABASE_PATH=              # optional sqlite path override
PORT=5000

# ---------- Contact / WhatsApp ----------
# Phone in E.164 format WITHOUT the leading "+" (wa.me format)
# Example for México: 5215551234567
WHATSAPP_NUMBER=
CONTACT_EMAIL=info@jdpeptides.com
CONTACT_LOCATION=México

# ---------- Email (Resend) ----------
RESEND_API_KEY=             # https://resend.com — crea aquí: https://resend.com/api-keys
EMAIL_FROM=JD Peptides <noreply@jdpeptides.mx>
EMAIL_BCC=jdpeptides@gmail.com        # copia oculta automática en TODOS los mails al cliente
EMAIL_NOTIFY=jdpeptides@gmail.com     # (csv) destinatarios de alertas internas (stock, OC, etc)

# ---------- Admin bootstrap ----------
# On an EMPTY admin_users table the app creates one superadmin from these.
# REQUIRED on first deploy. Password must be >= 10 chars.
# After the user exists, manage admins from /admin/usuarios — these env vars
# are ignored once the table is populated.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- AI (optional) ----------
ANTHROPIC_API_KEY=

# ---------- Analytics (optional) ----------
# Si está definida, inyecta gtag.js en todas las páginas (anonimizado).
# Formato: G-XXXXXXXXXX  — créala en https://analytics.google.com
GA_MEASUREMENT_ID=

# ---------- Error monitoring (optional) ----------
# Si está definida, captura excepciones no manejadas en producción.
# Sin valor → no se carga sentry-sdk. Crea proyecto Python/Flask en
# https://sentry.io y pega el DSN aquí.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- Cron jobs (Vercel Cron) ----------
# Si está definida, el endpoint /cron/send-abandoned-reminders queda
# protegido y Vercel Cron lo invoca cada 6h. Random string, e.g.
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sin esta env el endpoint cron retorna 403 (deshabilitado).
CRON_SECRET=
