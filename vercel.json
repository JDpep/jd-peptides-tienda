{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {"Cache-Control": "public, max-age=31536000, immutable"},
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/send-abandoned-reminders",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/cron/process-email-queue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/cron/gc",
      "schedule": "0 4 * * *"
    }
  ]
}
